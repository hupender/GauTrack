# Remote Supabase. Copy to .env.supabase and set passwords. NEVER commit .env.supabase
#
# IMPORTANT (Render / other IPv4-only hosts):
#   db.PROJECT.supabase.co is IPv6-only — connection will fail with "Network is unreachable".
#   Use Supabase → Connect → "Session pooler" (port 5432) and set POSTGRES_HOST to the
#   *pooler* hostname (e.g. aws-0-ap-south-1.pooler.supabase.com — copy yours from the UI).
#   Usernames on the pooler: postgres.PROJECT_REF and gautrack_app.PROJECT_REF

POSTGRES_HOST=aws-0-REGION.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_OWNER_USER=postgres.seosmqszfjpiytcjcbee
POSTGRES_PASSWORD=REPLACE_WITH_SUPABASE_DB_PASSWORD

POSTGRES_APP_USER=gautrack_app.seosmqszfjpiytcjcbee
APP_DB_PASSWORD=REPLACE_WITH_GAUTRACK_APP_PASSWORD

# Optional: keep db.* host for reference; pooler used when set (same as POSTGRES_HOST above if you prefer one field)
# POSTGRES_POOLER_HOST=aws-0-REGION.pooler.supabase.com

SEED_DEMO=1
SEED_PASSWORD=GauTrack-Demo-2026

SECRET_KEY=remote-seed-placeholder-change-on-render
