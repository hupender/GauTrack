# ---------------------------------------------------------------------------
# GauTrack MVP configuration.  Copy to `.env` and edit.  NEVER commit `.env`.
# `make dev` will create a `.env` for you with freshly generated secrets.
# ---------------------------------------------------------------------------

# --- Secrets -------------------------------------------------------------
# 32+ random bytes, hex.  Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# Postgres passwords.  `POSTGRES_PASSWORD` is the *owner* role (owns the schema,
# runs Alembic).  `APP_DB_PASSWORD` is the low-privilege role the API runs as:
# it has no UPDATE/DELETE on `events` and only SELECT on `audit_log`.
POSTGRES_PASSWORD=CHANGE_ME_owner_password
APP_DB_PASSWORD=CHANGE_ME_app_password

# --- Database ------------------------------------------------------------
POSTGRES_DB=gautrack
POSTGRES_OWNER_USER=gautrack_owner
POSTGRES_APP_USER=gautrack_app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full URLs are derived from the parts above unless you set them explicitly.
# DATABASE_URL=postgresql+psycopg://gautrack_app:pw@db:5432/gautrack
# DATABASE_URL_OWNER=postgresql+psycopg://gautrack_owner:pw@db:5432/gautrack

# --- Deployment ----------------------------------------------------------
# Caddy site address.  Use `localhost` for local TLS, a real hostname in prod.
SITE_ADDRESS=cattle.example.gov.in
# Contact address Caddy uses for ACME/Let's Encrypt registration.
ACME_EMAIL=it-cell@example.gov.in

# --- Application ---------------------------------------------------------
# quote any value that can contain spaces — .env is sourced by shell scripts too
PHOTO_DIR="/data/photos"
# Map tiles.  This is the ONLY outbound URL the browser is allowed to hit.
# Production: replace with self-hosted PMTiles / NIC Bharat Maps.
MAP_TILES_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_TILES_ATTRIBUTION="&copy; OpenStreetMap contributors"

# Set to 1 to load the demo dataset (see §8 of SPEC.md).  Set 0 in production.
SEED_DEMO=1

# Fixed password for the seeded demo accounts.  Leave empty and each NEW account
# gets a random password (right for a demo laptop: it is never shipped with a
# guessable one).  Set it and every seeded account shares that password, every
# time, which is what a pilot wants — `make reseed` then cannot invalidate the
# credentials a field phone is already using.
#
# Note that `make reseed` KEEPS existing passwords regardless, so this only
# affects accounts being created for the first time.  For a single account with
# a chosen password, use `make set-password U=<username>` instead.
# Never set this on a production deployment: real accounts belong in /admin/users.
SEED_PASSWORD=

# Set to 1 only behind TLS-terminating Caddy (adds `Secure` to cookies).
# `make dev` serves plain HTTP on localhost and sets this to 0.
COOKIE_SECURE=1

# Comma-separated trusted proxy hops; used to read X-Forwarded-For safely.
TRUSTED_PROXY_COUNT=1

# Session idle expiry (minutes)
SESSION_IDLE_MINUTES_FIELD=720
SESSION_IDLE_MINUTES_ADMIN=120

LOG_LEVEL=info
