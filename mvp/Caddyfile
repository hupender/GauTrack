{
	# ACME contact; omit `email` if you supply your own certs.
	email {$ACME_EMAIL}
	# Do not leak the server banner.
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Largest legitimate request is one 5 MB photo plus multipart overhead.
	request_body {
		max_size 10MB
	}

	# ---- Security headers -------------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
		-Server
	}

	# The service worker must be allowed to control the whole origin.
	header /app/sw.js {
		Service-Worker-Allowed "/"
		Cache-Control "no-cache"
	}

	# Vendored JS/CSS is content-addressed by version in the filename; cache hard.
	header /static/vendor/* Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy api:8000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
